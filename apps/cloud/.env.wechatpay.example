# 微信支付：普通商户 / Native 扫码 / API v3 / 微信支付公钥验签。
# 复制为 apps/cloud/.env.wechatpay.local 后填写；local 文件及 .secrets/ 均已被 Git 忽略。
# 本文件只供本机核验和受控部署读取，不会被桌面或官网打包。
# 路径可填写绝对路径（建议用 /），或相对于本文件所在目录。

# 1. 商户平台 https://pay.weixin.qq.com → 账户中心 → 商户信息。
WECHAT_PAY_MCH_ID=

# 2. 与上述商户号绑定、用于支付的 AppID。
# 支持已认证的服务号/政府或媒体公众号、小程序、移动应用。
# 不要直接填当前“网站微信登录”的 AppID；请以商户平台的支付绑定关系为准。
WECHAT_PAY_APP_ID=

# 3. 商户平台 → 账户中心 → API 安全 → 商户 API 证书。
# 将 apiclient_cert.pem / apiclient_key.pem 放到仓库根目录 .secrets/wechatpay/，
# 或改为你现有文件的绝对路径。私钥保持在文件里，不要粘贴到聊天。
WECHAT_PAY_MERCHANT_CERT_FILE=../../.secrets/wechatpay/apiclient_cert.pem
WECHAT_PAY_PRIVATE_KEY_FILE=../../.secrets/wechatpay/apiclient_key.pem
# 证书序列号可留空，核验脚本会从上面的证书中读取；手填则核对是否一致。
WECHAT_PAY_MERCHANT_SERIAL_NO=

# 4. 商户平台 → 账户中心 → API 安全 → APIv3 密钥。
# 填商户平台上已设置的 32 位字母数字密钥；不是 AppSecret，也不是 APIv2 密钥。
WECHAT_PAY_API_V3_KEY=

# 5. 商户平台 → 账户中心 → API 安全 → 微信支付公钥。
# 下载 pub_key.pem 放到下面的路径，填写同一页面的 PUB_KEY_ID_...。
WECHAT_PAY_PUBLIC_KEY_ID=
WECHAT_PAY_PUBLIC_KEY_FILE=../../.secrets/wechatpay/pub_key.pem

# 6. 在商户平台确认后把对应项改为 true；检查脚本无法离线证明平台权限。
WECHAT_PAY_NATIVE_ENABLED=false
WECHAT_PAY_APP_ID_BOUND=false
# 确认商户已使用纯公钥模式（新商户默认公钥，或旧商户已完成公钥切换）。
# 若旧商户还在平台证书/公钥灰度期，请保持 false；仍可先跑不收款的 echo 测试。
WECHAT_PAY_PUBLIC_KEY_MODE_READY=false

# 7. 回调地址已为本项目预填，通常不用改；部署后才会实际接收通知。
WECHAT_PAY_NOTIFY_URL=https://bowerbird.cn/api/pay/wechat/notify
WECHAT_PAY_REFUND_NOTIFY_URL=https://bowerbird.cn/api/pay/wechat/refund-notify

# 不在此文件开启生产收款。完整核验和真实支付验收后，由部署流程单独启用。
