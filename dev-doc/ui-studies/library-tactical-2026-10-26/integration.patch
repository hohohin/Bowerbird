diff --git a/apps/desktop/src/components/LibraryTactical.css b/apps/desktop/src/components/LibraryTactical.css
new file mode 100644
--- /dev/null
+++ b/apps/desktop/src/components/LibraryTactical.css
@@ -0,0 +1,191 @@
+/* Approved library surface. Keep tokens local: canvas nodes and modal panels retain their themes. */
+.library-tactical {
+  --lt-base: #1d2224;
+  --lt-screen: rgb(44 51 54 / .76);
+  --lt-panel: rgb(35 42 45 / .92);
+  --lt-hover-screen: rgb(61 68 70 / .82);
+  --lt-hover: rgb(225 229 228 / .12);
+  --lt-selected: rgb(219 224 222 / .86);
+  --lt-selected-ink: #252b2d;
+  --lt-ink: #e5e8e7;
+  --lt-mark: #c7cecb;
+  --lt-shadow: rgb(0 0 0 / .42);
+  --lt-nav: rgb(221 226 224 / .13);
+  --file-gallery-background: var(--lt-base);
+  --library-glass-selected: var(--lt-selected);
+  --library-glass-selected-shadow: none;
+}
+html[data-theme="light"] .library-tactical {
+  --lt-base: #f5f4f0;
+  --lt-screen: rgb(235 237 233 / .72);
+  --lt-panel: rgb(243 244 240 / .92);
+  --lt-hover-screen: rgb(221 225 221 / .80);
+  --lt-hover: rgb(47 55 58 / .09);
+  --lt-selected: rgb(59 67 70 / .86);
+  --lt-selected-ink: #fff;
+  --lt-ink: #2c3437;
+  --lt-mark: #56615e;
+  --lt-shadow: rgb(31 39 42 / .22);
+  --lt-nav: rgb(49 59 62 / .11);
+}
+.app-topbar.library-tactical, .library-home.library-tactical,
+.categorized-library.library-tactical, .local-file-workspace.library-tactical { background: var(--lt-base); }
+.library-tactical :is(.catalog-sidebar, .file-browser-places) { background: var(--lt-base); border-color: transparent; }
+.app-topbar.library-tactical { border-color: transparent; box-shadow: none; }
+
+/* Paint only: control dimensions, placement and hit areas remain owned by their components. */
+.library-tactical :is(.app-button-dark, .app-button-accent, .topbar-account-trigger, .app-search,
+  .library-view-segments, .library-floating-surface, .library-filter-trigger, .thumbnail-size-slider,
+  .catalog-selection, .folder-selection-bar, .folder-history button, .folder-return, .file-place-add,
+  :where(.catalog-sidebar-heading button)) {
+  background: var(--lt-screen); color: var(--lt-ink); border-color: transparent;
+  border-radius: 0; box-shadow: none; backdrop-filter: none; -webkit-backdrop-filter: none;
+}
+.library-tactical :is(.app-topbar-view-controls, .app-search kbd, .library-view-switch button,
+  .library-view-switch-thumb, .library-media-switch button, .library-view-segments button,
+  .catalog-row, .catalog-section-title, .catalog-selection button, .folder-selection-bar button,
+  .library-filter-colors button, .library-filter-colors svg, .library-color-action,
+  .library-source-key-hint kbd, .library-tag-filter > button, .topbar-account-trigger > span,
+  .topbar-account-trigger > img, .file-place-row, .folder-navigation button,
+  .file-places-heading button, .file-place-remove) { border-radius: 0; box-shadow: none; }
+.library-tactical .folder-address { position: relative; border-radius: 0; border-color: transparent; background: var(--lt-screen); color: var(--lt-ink); }
+.library-tactical .folder-address:focus-within { border-color: transparent; background: var(--lt-hover-screen); }
+.library-tactical .folder-address:has(input:focus-visible) { outline-color: var(--lt-mark); }
+.library-tactical .folder-navigation button { background: var(--lt-screen); color: var(--lt-ink); }
+.library-tactical .folder-address button { background: transparent; }
+.library-tactical .folder-navigation button:not(:disabled):hover { background: var(--lt-hover-screen); color: var(--lt-ink); }
+.library-tactical .folder-history { border-color: transparent; }
+.library-tactical .app-search input { border-color: transparent; border-radius: 0; background: transparent; box-shadow: none; }
+.library-tactical .app-search input:focus { outline: 2px solid var(--lt-mark); outline-offset: 1px; }
+.library-tactical :is(.app-button-dark, .app-button-accent, .topbar-account-trigger,
+  .library-filter-trigger, :where(.catalog-sidebar-heading button)):hover { background-color: var(--lt-hover-screen); }
+.library-tactical .library-color-control > .library-filter-trigger { background: transparent; }
+.library-tactical :is(.library-view-switch-thumb, .library-media-switch button[aria-pressed="true"],
+  .library-view-segments button[aria-pressed="true"]),
+.library-tactical.library-motion-root .library-filter-trigger:is([aria-pressed="true"], [data-active="true"], [aria-expanded="true"]) {
+  background: var(--lt-selected); color: var(--lt-selected-ink); box-shadow: none;
+}
+.library-tactical .library-view-switch button[aria-selected="true"],
+.library-tactical .library-media-switch button[aria-pressed="true"]:hover { color: var(--lt-selected-ink); }
+.library-tactical .library-view-switch button:not([aria-selected="true"]):hover { background: var(--lt-hover); color: var(--lt-ink); }
+.library-tactical .library-view-switch-thumb { transition-duration: 140ms; transition-timing-function: cubic-bezier(.2,.8,.2,1); }
+.library-tactical .library-tab-overlay { background: var(--lt-selected); }
+.library-tactical .library-tab-view-label { color: var(--lt-selected-ink); }
+.library-tactical .library-tab-crossing-arrow { stroke: var(--lt-selected-ink); }
+.library-tactical .app-topbar-credits { color: inherit; }
+.library-tactical .topbar-account-trigger > span.bg-accent { background: var(--lt-selected); color: var(--lt-selected-ink); }
+.library-tactical .library-filter-dot { display: none; }
+.library-tactical .library-rgb-orb { border-radius: 0; box-shadow: none; }
+.library-tactical :is(.catalog-row, .file-place-row):hover { background: var(--lt-hover); }
+.library-tactical :is(.catalog-row, .file-place-row):is([aria-current="location"], [aria-selected="true"], [aria-pressed="true"]) { background: var(--lt-nav); color: var(--lt-ink); }
