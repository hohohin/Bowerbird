{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bowerbird Explorer Test",
  "version": "0.0.0",
  "identifier": "com.bowerbird.explorer-test",
  "build": { "devUrl": "http://127.0.0.1:1557", "frontendDist": "../../../../dist" },
  "bundle": { "active": false, "icon": ["../../../icons/icon.png"] },
  "app": {
    "windows": [{ "label": "main", "title": "Explorer isolated test", "width": 1100, "height": 800, "visible": false, "dragDropEnabled": false }],
    "security": { "capabilities": [{ "identifier": "test-main", "webviews": ["main"], "permissions": ["core:default"] }] }
  }
}
