FROM public.ecr.aws/docker/library/node:24-bookworm-slim@sha256:ba849c60be29959425b8734d57b8b4b7d56f98edd9504c9af091d5281095a71e

ARG PNPM_VERSION=11.10.0

RUN corepack enable \
    && corepack prepare "pnpm@${PNPM_VERSION}" --activate

WORKDIR /opt/bowerbird-dsh-profile

# The test-only deployment candidate consumes the already audited,
# lockfile-pinned profile as a named build context. Remote deployment remains
# separately gated even though compose.generation.yml can now build this image.
COPY --from=dsh-profile package.json pnpm-lock.yaml pnpm-workspace.yaml cordis.yml cordis.patch.yml cordis.bridge.patch.yml cordis.controlled-model.patch.yml cordis.html-execution.patch.yml cordis.content-execution.patch.yml ./
COPY --from=dsh-profile plugins/bowerbird-planning-rpc.mjs plugins/bowerbird-planning-tools.mjs plugins/bowerbird-controlled-model-tools.mjs plugins/bowerbird-html-execution-tools.mjs plugins/bowerbird-content-execution-tools.mjs ./plugins/

RUN pnpm install --frozen-lockfile --ignore-scripts \
    && rm -rf /root/.cache/node/corepack \
        /usr/local/lib/node_modules/corepack \
        /usr/local/lib/node_modules/npm \
    && rm -f /usr/local/bin/corepack \
        /usr/local/bin/npm \
        /usr/local/bin/npx \
        /usr/local/bin/pnpm \
        /usr/local/bin/pnpx

ENV BOWERBIRD_DSH_PROFILE_TEMPLATE=/opt/bowerbird-dsh-profile \
    BOWERBIRD_DSH_RUNTIME_ROOT=/dsh-runtime \
    BOWERBIRD_UNIFIED_AGENT_DSH_ENABLED=false \
    BOWERBIRD_CONTROLLED_IMAGE_EDIT_DSH_ENABLED=false \
    DSH_TELEMETRY_DISABLED=1 \
    DSH_PERMISSION_MODE=read-only

WORKDIR /app
RUN ln -s /opt/bowerbird-dsh-profile/node_modules /app/node_modules
COPY src ./src
COPY scripts/dsh-readonly-probe.mjs ./scripts/dsh-readonly-probe.mjs

USER node
CMD ["node", "src/main.ts"]
