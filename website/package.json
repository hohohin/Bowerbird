{
  "name": "@bowerbird/website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "bundle:file": "vite build --config vite.file.config.js",
    "dev": "pnpm run bundle:file && node server.mjs --root .",
    "dev:vite": "pnpm run bundle:file && vite --host 127.0.0.1",
    "build": "pnpm run bundle:file && vite build",
    "preview": "node server.mjs --root dist",
    "start": "node server.mjs --root dist"
  },
  "dependencies": {
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.1"
  },
  "devDependencies": {
    "vite": "^5.4.8"
  }
}
