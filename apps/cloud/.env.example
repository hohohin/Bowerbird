# =============================================================================
# Bowerbird Cloud · 环境变量模板
# 复制为 .env.local 填写；.env.local 绝不入库（已加 .gitignore）
# 标注说明： [公开]=可进客户端/前端   [机密]=只允许存在于服务端环境变量
# 对应人工前置清单编号见 ARCH-ADJUST-PLAN.md §2（H1–H5）
# =============================================================================

# ---------- H1 · Supabase 项目 ----------
# 项目设置 → API 页面可拿到
SUPABASE_URL=https://wpupyuurwmaeozyvkyuo.supabase.co              # [公开]
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...            # [公开] 桌面端/官网也要用
SUPABASE_SECRET_KEY=sb_secret_...                      # [机密] 仅 Functions/webhook 用，绕过 RLS

# ---------- H2 · 火山方舟（托管算力，按量计费） ----------
# 控制台 → API Key 管理；endpoint id 在「在线推理」创建接入点后获得
ARK_API_KEY=xxxxxxxx-xxxx-xxxx                     # [机密]
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3   # 一般不用改
ARK_IMAGE_MODEL=doubao-seedream-x-x-xxxxxx         # 生图 endpoint id（Seedream）
ARK_IMAGE_MODEL_LITE=doubao-seedream-x-x-xxxxxx    # Lite 模型（image_lite 与遗留 image_sd 档，VPS Worker 用）
ARK_VIDEO_MODEL=doubao-seedance-x-x-xxxxxx         # 生视频 endpoint id（Seedance）
ARK_VISION_MODEL=doubao-vision-x-x-xxxxxx          # 反推/理解 endpoint id（豆包 vision）

# ---------- G0 · Cloud 图片生成 Worker ----------
# 专用 Worker Token 同时写入 Supabase Function Secret 与 VPS；不要复用 service_role。
GENERATION_CONTROL_URL=https://wpupyuurwmaeozyvkyuo.supabase.co/functions/v1/generation-worker
GENERATION_WORKER_TOKEN=replace-with-48-byte-random-token  # [机密·Worker]
GENERATION_WORKER_ID=lighthouse-guangzhou-1
GENERATION_POLL_INTERVAL_MS=2000
GENERATION_HEARTBEAT_INTERVAL_MS=30000

# ---------- 理解（反推）异步队列 ----------
# understand-worker 控制面（与生图同容器、同安全边界）；UNDERSTAND_ASYNC 是 understand-proxy
# 的灰度开关：false=旧同步单次请求行为；true=create/get 短请求 + VPS Worker 执行（摆脱 Edge 墙钟）。
UNDERSTAND_CONTROL_URL=https://wpupyuurwmaeozyvkyuo.supabase.co/functions/v1/understand-worker
UNDERSTAND_WORKER_TOKEN=replace-with-48-byte-random-token  # [机密·Worker]
UNDERSTAND_WORKER_ID=lighthouse-guangzhou-1
UNDERSTAND_POLL_INTERVAL_MS=2000
UNDERSTAND_HEARTBEAT_INTERVAL_MS=30000
UNDERSTAND_ASYNC=false                               # Edge Secret；VPS Worker 上线且新桌面端发布后翻 true
UNDERSTAND_BURST_RETRY_MAX=3                         # 方舟 RequestBurstTooFast 自动重试上限（0=关）
UNDERSTAND_BURST_RETRY_BASE_MS=1500                  # 退避基值；实际延迟 = base*2^n + 随机抖动

# ---------- H2.1 · DeepSeek（Agent 文本回合；VPS Worker 用，Edge 不用） ----------
# DeepSeek 平台 → API Keys 创建。deepseek-chat 支持 tool calling；deepseek-reasoner 不支持、不可用。
# 本段 [机密·Worker]：A2/A7 由部署脚本注入 VPS Worker（Docker env），不用 supabase secrets set。
# A0-T1 spike 前可临时填到 .env.local 用本地脚本验证 tool calling。
DEEPSEEK_API_KEY=sk-xxxxxxxx                        # [机密·Worker]
DEEPSEEK_MODEL=deepseek-chat                        # 固定 deepseek-chat（勿用 reasoner）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1       # 一般不用改

# ---------- A2/A3 · Bowerbird 受控图片 Agent Worker ----------
# 与 generation/understand consumer 运行在同一受限容器；仍只持 Worker Token，不持 service role。
AGENT_CONTROL_URL=https://wpupyuurwmaeozyvkyuo.supabase.co/functions/v1/agent-worker
AGENT_WORKER_TOKEN=replace-with-48-byte-random-token # [机密·Worker；同时配置为 Edge secret]
AGENT_WORKER_ID=lighthouse-guangzhou-1
AGENT_POLL_INTERVAL_MS=2000
AGENT_HEARTBEAT_INTERVAL_MS=20000
AGENT_MAINTENANCE_INTERVAL_MS=600000              # Agent TTL/orphan 清理周期（10 分钟）
AGENT_WORKSPACE_ROOT=/workspaces                    # 容器 tmpfs；每个 Run 独立子目录
RENDERER_URL=http://html-renderer:3917              # Docker internal 网络固定地址
RENDER_INTERNAL_TOKEN=replace-with-32-byte-random-token # [机密·VPS；与 html-renderer 完全一致]
VISUAL_PROFILE_CONTROL_URL=https://wpupyuurwmaeozyvkyuo.supabase.co/functions/v1/visual-profile-worker
VISUAL_PROFILE_WORKER_TOKEN=replace-with-48-byte-random-token # [机密·Worker；同时配置为 Edge secret]
VISUAL_PROFILE_WORKER_ID=lighthouse-guangzhou-1
AGENT_GLOBAL_ACTIVE_LIMIT=100                     # 全站 Agent 活动 Run 上限；数据库原子闸
BOWERBIRD_AGENT_MOCK=false                          # 仅本地/测试 VPS 使用；生产必须 false

# ---------- A8 · Agent 小流量门控（Edge secret：entitlement + agent-run create 同口径复核） ----------
# all=全量开放（默认，未配置等同）；test_only=仅 raw_app_meta_data.bowerbird_test='true' 标记账号可用 Agent
# （账号标记复用 0036 遥测通道：supabase auth admin API 更新 app_metadata）。观察名单就绪后翻 test_only。
AGENT_ACCESS_MODE=all

# ---------- P9 · Entitlement 非对称签名（7 天离线 Pro 宽限） ----------
# 私钥 [机密]：仅 Edge entitlement Function 使用（WebCrypto Ed25519，PKCS#8 DER base64）。
# 公钥 [公开]：注入桌面构建环境 BOWERBIRD_ENTITLEMENT_PUBKEY（原始 32 字节 base64），
# 桌面验签通过后才允许缓存快照解锁离线 Pro/Studio。两者成对轮换。
# 生成：node apps/cloud/scripts/gen-entitlement-keypair.mjs（输出 secrets set 命令与公钥）
ENTITLEMENT_SIGNING_KEY=                                        # [机密] 留空 = 不签名，signature_version=0

# ---------- H3 · superun 支付（国内，微信+支付宝托管收银台） ----------
# 字段名以 superun 商户后台实际为准，接入时按文档对齐
SUPERUN_MERCHANT_ID=                               # [机密] 商户号
SUPERUN_API_KEY=                                   # [机密] 下单签名用
SUPERUN_WEBHOOK_SECRET=                            # [机密] 回调验签用

# ---------- H4 · Paddle 支付（海外，可延后） ----------
PADDLE_ENV=sandbox                                 # sandbox / production
PADDLE_API_KEY=                                    # [机密]
PADDLE_WEBHOOK_SECRET=                             # [机密]

# ---------- H5 · 微信开放平台（网站应用；备案域名 bowerbird.cn 已过，凭据已发） ----------
# 授权回调域在微信开放平台后台填 bowerbird.cn（不带协议）；redirect 指向备案域名上的静态中转页。
WECHAT_APP_ID=wx................                   # [公开] Edge GET 组装 qrconnect URL 用
WECHAT_APP_SECRET=                                # [机密] 仅 wechat-login Function 使用
WECHAT_REDIRECT_URI=https://bowerbird.cn/wechat-callback.html  # 中转页（VPS 伺服，非 supabase.co）

# ---------- 积分与限额配置（改配置不改代码） ----------
DAILY_FREE_CREDITS=30                              # 每日赠送分（当日清零）
TRIAL_CREDITS=30                                   # 官网注册体验分
FREE_CAPTION_DAILY_LIMIT=10                        # 免费档每日反推次数
PRO_SUB_CREDITS=800                                # Pro 每月订阅分
STUDIO_SUB_CREDITS=3000                            # Studio 每月订阅分
# 消耗表：service → 积分（0016/0017 迁移后生图档现阶段统一 1 分/张；image_fast=Pro+fast；image_sd 为遗留别名=Lite）
SERVICE_COSTS_JSON={"caption":1,"image_sd":1,"image_hd":1,"image_lite":1,"image_fast":1,"video_sd2_5s":100,"video_sd2_15s":280,"video_sd25_5s":160,"video_sd25_15s":450,"video_sd25_30s":900}

# ---------- 熔断与请求安全 ----------
DAILY_COST_LIMIT_CNY=500                           # 全站每日 API 成本熔断（元），超限返回 503
MAX_REQUEST_BODY_MB=20                             # 单请求体上限（参考图 base64）
ARK_IMAGE_TIMEOUT_MS=135000                        # 仅旧同步回退路径；G0 VPS 生图不使用该主动超时
UNDERSTAND_UPSTREAM_TIMEOUT_MS=110000              # 仅旧同步回退路径（understand-proxy 同步模式）
PROXY_TIMEOUT_MS=140000                            # 仅旧同步回退路径；G0 create/get 均为短请求
RATE_LIMIT_PER_USER_PER_MIN=10                     # 单用户每分钟请求上限
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,https://bowerbird.cn  # 官网微信登录浏览器直调 wechat-login
BOWERBIRD_CLOUD_MOCK=true                          # 开发期 true；生产必须 false 且真实 adapter 已配置

# ---------- 桌面端 / 官网构建期注入（[公开]，不涉密） ----------
# 桌面端 build.rs 会优先读取构建环境中的以下变量；本地构建也会读取上面的
# SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY。它们会被编译进客户端，不进入用户设置：
#   BOWERBIRD_SUPABASE_URL = 同 SUPABASE_URL
#   BOWERBIRD_SUPABASE_PUBLISHABLE_KEY = 同 SUPABASE_PUBLISHABLE_KEY
#   BOWERBIRD_ENTITLEMENT_PUBKEY = Entitlement 验签公钥（见上方 P9 段；可选，缺省=禁用离线宽限验签）
# 官网服务端仍使用 SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY。
