# 将此模板复制到 macOS/.signing/r2.env 后填写；真实凭据文件已被 Git 忽略。
# 只填写等号右侧，不要在值后追加注释；不要把真实密钥填进本 example。
# 使用目标桶的 R2 S3 API 凭据，权限仅需该桶的对象读写；无需 Workers 管理权限。

# S3 API 端点 https://<账户ID>.r2.cloudflarestorage.com 中的账户 ID。
R2_ACCOUNT_ID=

# R2 对象读写凭据的 Access Key ID 和 Secret Access Key（不是 API Token 字符串）。
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 存储桶名称，不是域名；本轮文件会上传到桶内 mac_package/ 前缀。
R2_BUCKET=

# 现有公开下载基地址，用于上传后的公网校验；若目标桶不同，请同步修改。
R2_PUBLIC_BASE=https://pub-5e4c00c218cd4682b622cbab5e58563e.r2.dev
