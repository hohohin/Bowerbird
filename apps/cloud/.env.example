# =============================================================================
# Bowerbird Cloud · 环境变量模板
# 复制为 .env.local 填写；.env.local 绝不入库（已加 .gitignore）
# 标注说明： [公开]=可进客户端/前端   [机密]=只允许存在于服务端环境变量
# 对应人工前置清单编号见 ARCH-ADJUST-PLAN.md §2（H1–H5）
# =============================================================================

# ---------- H1 · Supabase 项目 ----------
# 项目设置 → API 页面可拿到
SUPABASE_URL=https://wpupyuurwmaeozyvkyuo.supabase.co              # [公开]
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...            # [公开] 桌面端/官网也要用
SUPABASE_SECRET_KEY=sb_secret_...                      # [机密] 仅 Functions/webhook 用，绕过 RLS

# ---------- H2 · 火山方舟（托管算力，按量计费） ----------
# 控制台 → API Key 管理；endpoint id 在「在线推理」创建接入点后获得
ARK_API_KEY=xxxxxxxx-xxxx-xxxx                     # [机密]
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3   # 一般不用改
ARK_IMAGE_MODEL=doubao-seedream-x-x-xxxxxx         # 生图 endpoint id（Seedream）
ARK_VIDEO_MODEL=doubao-seedance-x-x-xxxxxx         # 生视频 endpoint id（Seedance）
ARK_VISION_MODEL=doubao-vision-x-x-xxxxxx          # 反推/理解 endpoint id（豆包 vision）

# ---------- H3 · superun 支付（国内，微信+支付宝托管收银台） ----------
# 字段名以 superun 商户后台实际为准，接入时按文档对齐
SUPERUN_MERCHANT_ID=                               # [机密] 商户号
SUPERUN_API_KEY=                                   # [机密] 下单签名用
SUPERUN_WEBHOOK_SECRET=                            # [机密] 回调验签用

# ---------- H4 · Paddle 支付（海外，可延后） ----------
PADDLE_ENV=sandbox                                 # sandbox / production
PADDLE_API_KEY=                                    # [机密]
PADDLE_WEBHOOK_SECRET=                             # [机密]

# ---------- H5 · 微信开放平台（网站应用，企业资质已确认） ----------
WECHAT_APP_ID=wx................                   # [公开]
WECHAT_APP_SECRET=                                 # [机密]
WECHAT_REDIRECT_URI=https://xxxx.supabase.co/functions/v1/wechat-callback

# ---------- 积分与限额配置（改配置不改代码） ----------
DAILY_FREE_CREDITS=30                              # 每日赠送分（当日清零）
TRIAL_CREDITS=30                                   # 官网注册体验分
FREE_CAPTION_DAILY_LIMIT=10                        # 免费档每日反推次数
PRO_SUB_CREDITS=800                                # Pro 每月订阅分
STUDIO_SUB_CREDITS=3000                            # Studio 每月订阅分
# 消耗表：service → 积分（与定价方案 v2 §3.2 对齐）
SERVICE_COSTS_JSON={"caption":1,"image_sd":5,"image_hd":10,"video_sd2_5s":100,"video_sd2_15s":280,"video_sd25_5s":160,"video_sd25_15s":450,"video_sd25_30s":900}

# ---------- 熔断与请求安全 ----------
DAILY_COST_LIMIT_CNY=500                           # 全站每日 API 成本熔断（元），超限返回 503
MAX_REQUEST_BODY_MB=20                             # 单请求体上限（参考图 base64）
UPSTREAM_TIMEOUT_MS=120000                         # 调方舟超时；为 Edge 150 秒请求上限预留回滚/响应时间
RATE_LIMIT_PER_USER_PER_MIN=10                     # 单用户每分钟请求上限
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173  # 官网部署后换为正式 HTTPS origin
BOWERBIRD_CLOUD_MOCK=true                          # 开发期 true；生产必须 false 且真实 adapter 已配置

# ---------- 桌面端 / 官网构建期注入（[公开]，不涉密） ----------
# 桌面端 build.rs 会优先读取构建环境中的以下变量；本地构建也会读取上面的
# SUPABASE_URL/SUPABASE_PUBLISHABLE_KEY。它们会被编译进客户端，不进入用户设置：
#   BOWERBIRD_SUPABASE_URL = 同 SUPABASE_URL
#   BOWERBIRD_SUPABASE_PUBLISHABLE_KEY = 同 SUPABASE_PUBLISHABLE_KEY
# 官网服务端仍使用 SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY。
