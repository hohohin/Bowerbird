FROM node:24-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY src ./src
COPY --from=cloud-shared video-contract.ts task-authorization.ts layer-contract.ts image-metadata.ts /cloud/supabase/functions/_shared/
COPY scripts/video-readonly-probe.mjs ./scripts/video-readonly-probe.mjs

USER node
CMD ["node", "src/main.ts"]
