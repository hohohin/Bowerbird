# 支付宝个人 Pro 订阅：资料准备模板，当前尚无代码读取这些配置。
# 真实资料只填 .env.alipay.local；此 example 禁止填写真实身份和密钥。
# 操作说明见 ALIPAY.md。先用沙箱；切正式环境时整套替换应用、PID、密钥及资源 ID。
ALIPAY_ENV=sandbox
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 正式环境：ALIPAY_ENV=production
# 正式网关：https://openapi.alipay.com/gateway.do

# 【必填】开放平台应用详情 APPID；不是商户 PID。
ALIPAY_APP_ID=
# 【必填】对应环境的商户 PID，用于核验收款主体；沙箱须用沙箱 PID。
ALIPAY_MERCHANT_PID=

# 【必填】本地密钥文件的绝对路径；文件内容不要粘到聊天。
# 应用私钥：你在本地生成并保管；推荐 RSA 2048、PKCS#8 PEM。
ALIPAY_APP_PRIVATE_KEY_PATH=
# 支付宝公钥：从同一应用的“接口加签方式”获取，不是应用公钥。
ALIPAY_PUBLIC_KEY_PATH=
ALIPAY_SIGN_TYPE=RSA2
ALIPAY_CHARSET=UTF-8
ALIPAY_FORMAT=json
ALIPAY_KEY_MODE=public_key
# 若现有应用已经采用证书模式，不要为本接入切换：改为 certificate，填下三项并保留应用私钥路径。
# 证书模式不要求填写上面的 ALIPAY_PUBLIC_KEY_PATH。
ALIPAY_APP_CERT_PATH=
ALIPAY_PUBLIC_CERT_PATH=
ALIPAY_ROOT_CERT_PATH=

# 【暂不改】规划通知地址，尚未实现/部署，不能现在当成有效网关配置。
# 沙箱和正式通知分开；正式规划为 https://bowerbird.cn/api/pay/alipay/notify
ALIPAY_NOTIFY_URL=https://bowerbird.cn/api/pay/alipay/sandbox/notify

# 【有则填写】没有就留空，后续接入时创建并保存；不能填微信/Mock 商品 ID。
# 两个 ID 必须属于上方同一环境、应用及商户。价格单位为分。
ALIPAY_PRO_MONTHLY_PRODUCT_ID=
ALIPAY_PRO_MONTHLY_PRICE_ID=
# 【暂不改】现有个人 Pro 月费；后续以服务端目录和订单快照为权威。
ALIPAY_PRO_MONTHLY_AMOUNT_MINOR=3900
ALIPAY_PRO_MONTHLY_INTERVAL=MONTH
ALIPAY_PRO_MONTHLY_INTERVAL_COUNT=1
ALIPAY_SUBSCRIPTION_MODE=SUBSCRIBE_DEDUCT

# 【完成后改 true】仅记录你在控制台确认的结果，不会自动开通权限。
# 沙箱阶段正式项保持 false；生产开通不作为沙箱测试前提。
ALIPAY_PRODUCTION_SUBSCRIPTION_APPROVED=false
ALIPAY_PRODUCTION_WEB_PAY_APPROVED=false
ALIPAY_PRODUCTION_APP_ONLINE=false
ALIPAY_PRODUCTION_CALL_AUTHORIZED=false
ALIPAY_SANDBOX_CALL_AUTHORIZED=false
# 通知必须在代码部署且实际验签/处理验证后才改 true。
ALIPAY_NOTIFY_VERIFIED=false
# 配置填完也不启用收款；后续代码、验收和部署另行推进。
ALIPAY_SUBSCRIPTION_ENABLED=false
