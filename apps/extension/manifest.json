{
  "manifest_version": 3,
  "name": "Bowerbird Collect",
  "version": "0.1.0",
  "description": "采集网页图片到本地 Bowerbird 桌面应用（ws://127.0.0.1:39871/ws）",
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
