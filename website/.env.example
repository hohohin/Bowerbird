# cn 默认使用 Seedream；其他地区默认使用 FLUX。也可直接填 seedream 或 flux。
BOWERBIRD_IMAGE_REGION=cn
BOWERBIRD_IMAGE_PROVIDER=auto
BOWERBIRD_GENERATION_LIMIT=3
BOWERBIRD_GLOBAL_DAILY_LIMIT=100
BOWERBIRD_TRIAL_TIME_ZONE=Asia/Shanghai
BOWERBIRD_TRUST_PROXY=0
PORT=4173

# 国内首选：火山方舟 Seedream 5.0 Lite
VOLCENGINE_ARK_API_KEY=
VOLCENGINE_SEEDREAM_MODEL=
VOLCENGINE_SEEDREAM_SIZE=2K

# 海外首选：Black Forest Labs FLUX.2 Klein 9B
BFL_API_KEY=
BFL_FLUX_ENDPOINT=flux-2-klein-9b
