{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bowerbird",
  "version": "26.11.2303",
  "identifier": "com.bowerbird.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Bowerbird",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost data: blob: http: https:",
        "media-src": "'self' asset: http://asset.localhost data: blob: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost asset: http://asset.localhost blob: https:",
        "worker-src": "'self' blob:",
        "frame-src": "'self' https://www.youtube-nocookie.com/embed/ https://player.vimeo.com/video/ https://player.youku.com/embed/ https://www.dailymotion.com/embed/video/ https://coub.com/embed/",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "$APPDATA/**"
          ],
          "deny": []
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM0NDAwQkNFRTI1MkNEOEUKUldTT3pWTGl6Z3RBeEc2NUZTWE4rblNUMmc3eTlXMElhQ1A4YjRZaG5OWnQ2dVEzVTBqdWFkYmgK",
      "endpoints": [
        "https://bowerbird.cn/api/desktop-update/{{target}}-{{arch}}"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "bowerbird"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "vendor/localsend-core/LICENSE": "licenses/localsend/LICENSE",
      "vendor/localsend-core/README.bowerbird.md": "licenses/localsend/README.bowerbird.md",
      "../../extension/": "extension/",
      "resources/samples/*": "samples/",
      "resources/onboarding-v0917/*": "onboarding-v0917/"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "template": "windows/installer.nsi",
        "installerHooks": "windows/installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
