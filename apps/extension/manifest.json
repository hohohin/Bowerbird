{
  "manifest_version": 3,
  "name": "Bowerbird Collect",
  "version": "0.1.0",
  "description": "采集网页图片到本地 Bowerbird 桌面应用（ws://127.0.0.1:39871/ws）",
  "icons": {
    "16": "icons/16x16.png",
    "32": "icons/32x32.png",
    "48": "icons/48x48.png",
    "128": "icons/128x128.png"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"],
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["candidate-utils.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
